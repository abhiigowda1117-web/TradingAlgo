# paper (default, simulated fills) or live (real orders through Zerodha Kite)
TRADING_MODE=paper

# Where candles and quotes come from: yahoo (free, delayed) or kite (needs the Kite historical-data add-on)
MARKET_DATA=yahoo

# Starting cash for the paper account (INR)
PAPER_CAPITAL=500000

# Zerodha Kite Connect app credentials (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
# Expires every day around 6 AM IST. Refresh with: npm run kite-login
KITE_ACCESS_TOKEN=

# ---------------------------------------------------------------- AlgoTrade website (npm run server)
# Database. Leave DATABASE_URL empty to use the built-in database file data/algotrade.db: nothing to
# install, and copying the data folder moves everything (accounts, research, paper portfolio) to another
# computer. Only for a PostgreSQL server (e.g. on a hosting server) set it, writing any @ in the password as %40:
# DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/algotrade
DATABASE_URL=

# Where the website listens. 0.0.0.0 lets your phone or other computers (Tailscale, home Wi-Fi) open it;
# the Windows firewall still decides who may connect. Use 127.0.0.1 to allow only this computer.
# On a hosting server keep 127.0.0.1 and put an HTTPS proxy in front of it.
PORT=3001
HOST=0.0.0.0

# Extra web addresses allowed to call the API (comma separated). Not needed for this computer, IP addresses
# or Tailscale names: the site accepts its own address automatically. On a hosting server add your domain,
# e.g. https://algotrade.example.com
APP_ORIGIN=http://localhost:5173,http://localhost:3001

# Sign-in session length in hours
SESSION_TTL_HOURS=12

# Website prices and charts: yahoo (free, delayed ~15 min) or kite (Zerodha Kite Connect: exchange prices).
# kite needs KITE_API_KEY and a fresh KITE_ACCESS_TOKEN (npm run kite-login each morning). Charts from Kite
# need the historical-data add-on. Read-only: the website never places orders. If Kite fails, the site
# shows Yahoo Finance and says why on the page.
WEB_MARKET_DATA=yahoo

# Production only: NODE_ENV=production, COOKIE_SECURE=true (requires HTTPS), TRUST_PROXY=true behind a reverse proxy
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
