# paper (default, simulated fills) or live (real orders through Zerodha Kite)
TRADING_MODE=paper

# Where candles and quotes come from: yahoo (free, delayed) or kite (needs the Kite historical-data add-on)
MARKET_DATA=yahoo

# Starting cash for the paper account (INR)
PAPER_CAPITAL=500000

# Zerodha Kite Connect app credentials (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
# Expires every day around 6 AM IST. Refresh with: npm run kite-login
KITE_ACCESS_TOKEN=
