{
  "name": "trading-algo",
  "version": "0.1.0",
  "private": true,
  "description": "NSE company study (screener, fundamental scoring, news sentiment, reports) feeding a live trading engine for Zerodha Kite.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "study": "tsx src/cli/study.ts",
    "report": "tsx src/cli/report.ts",
    "research": "tsx src/cli/research.ts",
    "company": "tsx src/cli/company.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "portfolio": "tsx src/cli/portfolio.ts",
    "trade": "tsx src/cli/trade.ts",
    "kite-login": "tsx src/cli/kiteLogin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "tsx src/server/index.ts",
    "db:migrate": "tsx src/cli/dbMigrate.ts",
    "user:create": "tsx src/cli/createUser.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "chart.js": "4.4.1",
    "dotenv": "16.4.5",
    "fast-xml-parser": "5.11.2",
    "pg": "8.13.1",
    "yahoo-finance2": "4.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.11.10",
    "pg-mem": "3.0.4",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "5.0.5"
  }
}
